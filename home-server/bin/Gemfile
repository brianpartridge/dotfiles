# frozen_string_literal: true

# The server runs the scripts with the rbenv Ruby in .ruby-version and the
# gems installed in it. The scripts do not load Bundler, so install these
# gems on the server with `bundle install`.

source 'https://rubygems.org'

# Runtime
gem 'nokogiri', '~> 1.19'
gem 'rss'
gem 'webrick'

# Tests
gem 'rake', '~> 13.0'
gem 'rspec', '~> 3.13'
