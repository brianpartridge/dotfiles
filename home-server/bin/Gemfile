# frozen_string_literal: true

# Test gems only. Run the specs with `bundle exec rspec`.
#
# The server does not use Bundler. It runs the scripts with /usr/bin/ruby
# 2.3.7 and the gems installed on it. The scripts need these gems there:
# hdbits, imdb_watchlist and nokogiri.

source 'https://rubygems.org'

gem 'rake', '~> 13.0'
gem 'rspec', '~> 3.13'
