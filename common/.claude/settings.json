{
  "model": "fable[1m]",
  "hooks": {
  	"PostToolUse": [
	  {
		"matcher": "Bash|EnterWorktree",
		"hooks": [
		  {
			"type": "command",
			"command": "python3 -I ~/.claude/session-cleanup/ledger_hook.py",
			"timeout": 10
		  }
		]
	  },
	  {
		"matcher": "mcp__ccd_session_mgmt__archive_session",
		"hooks": [
		  {
			"type": "command",
			"command": "python3 -I ~/.claude/session-cleanup/archive_hook.py",
			"timeout": 10
		  }
		]
	  }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/session-cleanup/archive_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reply in ASD-STE100 Simplified Technical English. Result first. One instruction per sentence. Max 20 words per sentence. Active voice, present tense. Approved words only. No idioms, no em-dashes, no asides.'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "firebase@firebase": true
  },
  "extraKnownMarketplaces": {
    "firebase": {
      "source": {
        "source": "github",
        "repo": "firebase/firebase-tools"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
